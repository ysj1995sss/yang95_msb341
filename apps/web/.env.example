# Copy to .env.local (never committed) and fill in. See specs/009 appendix A.

# Where the workspace API (apps/api) runs. The browser never calls it directly.
API_URL=http://127.0.0.1:8000

# Google sign-in. Leave both empty for local single-user mode (no sign-in, like the
# Streamlit app without [auth]). Redirect URI: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Random values of at least 32 characters, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# AUTH_SECRET signs the session cookie. WORKSPACE_TOKEN_SECRET must equal the API's.
AUTH_SECRET=
WORKSPACE_TOKEN_SECRET=
